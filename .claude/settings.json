{
    "permissions": {
        "allow": [
            "Bash(pnpm install)",
            "Bash(pnpm lint)",
            "Bash(pnpm -r lint)",
            "Bash(pnpm test)",
            "Bash(pnpm -r test)",
            "Bash(pnpm build)",
            "Bash(pnpm -r build)",
            "Bash(pnpm format)",
            "Bash(pnpm format:check)",
            "Bash(pnpm -r format:check)",
            "Bash(npx prettier *)",
            "Bash(npx vitest run *)"
        ]
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
                    }
                ]
            }
        ]
    }
}

# Chalkboard — example Wrangler configuration.
#
# Copy to wrangler.toml, fill in the two ids below, then follow
# deploy/README.md for the full quickstart.

# Worker name; also becomes the workers.dev subdomain.
name = "chalkboard"

# Entry point: imports createFeedbackApp from @chalkcom/worker source.
main = "worker/index.js"

compatibility_date = "2026-08-01"

# The board SPA + sdk.js, assembled into ./dist by
# `node scripts/assemble.mjs` after `pnpm -r build`.
# not_found_handling serves index.html for client-side routes.
[assets]
directory = "./dist"
binding = "ASSETS"
not_found_handling = "single-page-application"

# D1 database. Create it with:
#   wrangler d1 create feedback
# then paste the printed database_id here.
[[d1_databases]]
binding = "DB"
database_name = "feedback"
database_id = "00000000-0000-0000-0000-000000000000"
migrations_dir = "./migrations"

# KV namespace backing the rate limiter. Create with:
#   wrangler kv namespace create RATE
# then paste the printed id here.
[[kv_namespaces]]
binding = "RATE"
id = "0000000000000000000000000000000000"

# Nightly cron: prunes analytics events older than 180 days.
[triggers]
crons = ["0 3 * * *"]

[vars]
# Public URL of this deployment (used for SSO redirects and CSRF checks).
PUBLIC_URL = "https://feedback.example.com"
# Comma-separated origins allowed to call the API from a browser (your app
# that hosts the embed/hints). `*` is allowed once per entry as a
# subdomain wildcard — scope it to YOUR site's previews, e.g.
# https://*--your-site.netlify.app. NEVER allow a bare shared-hosting
# suffix like https://*.netlify.app: anyone can deploy under it. Wildcard
# matches are also weaker on purpose: they get CORS access WITHOUT
# credentials, so session cookies only ever ride exact entries.
ALLOWED_ORIGINS = "https://app.example.com"
# 'true' to accept posts from visitors without a JWT/session.
ALLOW_ANONYMOUS_POSTS = "false"

# AI interviewer (docs/assist.md) — optional, bring your own Anthropic key.
# Model for follow-up questions + synthesis; default claude-opus-5.
# Cheaper alternatives: claude-sonnet-5, claude-haiku-4-5.
# ASSIST_MODEL = "claude-opus-5"
# Set to 'false' to switch assist off without removing the key.
# ASSIST_ENABLED = "true"

# Secrets — set these with wrangler, never in this file:
#   wrangler secret put FEEDBACK_JWT_SECRET   # shared HS256 secret with your app
#   wrangler secret put IMPORT_TOKEN          # bearer token for POST /api/v1/import
#   wrangler secret put ANTHROPIC_API_KEY     # enables the AI interviewer (docs/assist.md)
